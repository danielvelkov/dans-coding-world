{
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to API",
      "port": 9229,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://@dans-coding-world/api/./*": "${workspaceFolder}/apps/api/*",
        "webpack://@dans-coding-world/api/../../libs/*": "${workspaceFolder}/libs/*"
      }
    }
  ]
}
