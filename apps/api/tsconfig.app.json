{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "nodenext",
    "types": ["node", "express"],
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/main.ts",
    "src/controllers/auth.controller.ts",
    "src/routes/auth.router.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/shared/util/shared-constants/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/util/exceptions/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/data-access/user/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/util/util-auth/tsconfig.lib.json"
    }
  ]
}
