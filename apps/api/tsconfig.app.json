{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "nodenext",
    "types": ["node", "express"],
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true
  },
  "include": [
    "src/**/*.ts",
    "src/main.ts",
    "src/controllers/*.ts",
    "src/routes/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/tools/api/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/util/api-types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/util/exceptions/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/user/dtos/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/users/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/reports/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/report/dtos/tsconfig.lib.json"
    },
    {
      "path": "../../libs/prisma-schema/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/post/dtos/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/posts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/util/shared-constants/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/auth/dtos/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/auth/tsconfig.lib.json"
    }
  ]
}
