{
  "name": "@dans-coding-world/public-blog-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "reset-only": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx reset"
        }
      },
      "cypress-clean": {
        "executor": "nx:run-commands",
        "options": {
          "parallel": true,
          "commands": [
            "nx serve:e2e api",
            "nx open-cypress public-blog-e2e"
          ]
        },
        "dependsOn": [
          "reset-only"
        ]
      },
      "e2e": {
        "dependsOn": [
          "@dans-coding-world/api:build",
          "@dans-coding-world/api:serve:e2e"
        ]
      }
    },
    "implicitDependencies": [
      "@dans-coding-world/public-blog"
    ]
  }
}
