{
	"name": "@dans-coding-world/blog-admin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.54.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"svelte": "^5.55.8",
		"vite": "^7.3.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.2.2",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "0.7.2",
		"svelte-check": "^4.4.8",
		"tailwindcss": "4.2.2"
	},
	"nx": {
		"targets": {
			"serve-all": {
				"executor": "nx:run-commands",
				"options": {
					"commands": [
						"nx run @dans-coding-world/blog-admin:dev",
						"nx run @dans-coding-world/api:serve:e2e"
					],
					"parallel": true,
					"readyWhen": "Listening at http://localhost:3000/api"
				}
			},
			"test": {
				"executor": "nx:run-commands",
				"options": {
					"command": "npm run test:unit -- --run",
					"passWithNoTests": true,
					"cwd": "{projectRoot}"
				}
			},
			"test:watch": {
				"executor": "nx:run-commands",
				"options": {
					"command": "npm run test:unit -- --watch",
					"passWithNoTests": true,
					"cwd": "{projectRoot}"
				}
			}
		}
	}
}
