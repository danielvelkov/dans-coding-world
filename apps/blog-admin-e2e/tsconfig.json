{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "**/*.json",
    "playwright.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs"
  ],
  "references": [
    {
      "path": "../../libs/tools/api"
    },
    {
      "path": "../../libs/shared/post/testing"
    },
    {
      "path": "../../libs/shared/util/shared-constants"
    },
    {
      "path": "../../libs/shared/util/helpers"
    },
    {
      "path": "../../libs/prisma-schema"
    },
    {
      "path": "../../libs/shared/data-access/api"
    }
  ]
}
