{
  "name": "@dans-coding-world/public-blog",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "serve-all": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "nx run @dans-coding-world/public-blog:serve",
            "nx run @dans-coding-world/api:serve:e2e"
          ],
          "parallel": true,
          "readyWhen": "Listening at http://localhost:3000/api"
        }
      },
      "serve:e2e": {
        "executor": "@nx/web:file-server",
        "defaultConfiguration": "production",
        "options": {
          "buildTarget": "@dans-coding-world/public-blog:build:production",
          "port": 4200
        }
      }
    },
    "tags": [
      "scope:frontend",
      "layer:public-blog",
      "type:app"
    ]
  }
}
