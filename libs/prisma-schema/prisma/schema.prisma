// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  password String
  role Role @default(USER)
  refreshTokens RefreshToken[]
  posts Post[]
  comments Comment[]
  reports Report[]
  moderationHistory ReportHistory[]
  profile Profile? 
}

model Profile {
  id Int  @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int @unique 
  firstName String
  lastName String
  bio String
  avatarURL String
}

model RefreshToken {
  jti String @id 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  revoked Boolean @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Post {
  id Int @id @default(autoincrement())
  status PostStatus @default(DRAFT)
  title String
  content String @db.Text
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  publishedAt DateTime?  // we start out as a draft so no published date is set
  visibility PostVisibility @default(PUBLIC)
  comments Comment[]
  tags TagsOnPosts[]
}

model Tag {
  id Int @id @default(autoincrement())
  name String @unique
  posts TagsOnPosts[]
}

model TagsOnPosts {
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int 
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId Int 

  @@id([postId, tagId])
}

model Comment {
  id Int @id @default(autoincrement())
  content String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  threadParentId Int? 
  threadParent Comment? @relation("ReplyThread", fields: [threadParentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("ReplyThread")
  depth Int @default(0)
  reports Report[]
}

model Report {
  id Int @id @default(autoincrement())
  reportedBy User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId Int
  reportedComment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int
  reason String
  createdAt  DateTime   @default(now())
  status ReportStatus @default(PENDING) 
  history ReportHistory[]
  @@unique([reporterId, commentId])
}

model ReportHistory {
  id Int @id @default(autoincrement())
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId Int 
  moderator User? @relation(fields: [moderatorId], references: [id], onDelete: SetNull)
  moderatorId Int? 
  previousStatus ReportStatus 
  newStatus ReportStatus 
  note String?
  changedAt DateTime @default(now())
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum Role {
  ADMIN
  MOD
  AUTHOR
  USER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostVisibility {
  PUBLIC
  MEMBERS_ONLY
}