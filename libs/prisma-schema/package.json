{
  "name": "@dans-coding-world/prisma-schema",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "nx": {
    "tags": [
      "layer:data-access",
      "scope:shared",
      "type:lib"
    ],
    "targets": {
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev"
        }
      },
      "generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate"
        }
      },
      "migrate:e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev",
          "envFile": "../../.e2e.env"
        }
      },
      "generate:e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate",
          "envFile": "../../.e2e.env"
        }
      }
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {}
}
