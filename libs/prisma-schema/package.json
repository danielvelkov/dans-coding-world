{
  "name": "@dans-coding-world/prisma-schema",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "nx": {
    "tags": [
      "layer:data-access",
      "scope:shared",
      "type:lib"
    ],
    "targets": {
      "prisma-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev",
          "cwd": "libs/prisma-schema/prisma"
        }
      },
      "generate-types": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate",
          "cwd": "libs/prisma-schema/prisma"
        },
        "dependsOn": [
          "prisma-migrate"
        ]
      },
      "prisma-migrate:e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev",
          "cwd": "libs/prisma-schema/prisma"
        },
        "defaultConfiguration": "e2e"
      },
      "generate-types:e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate",
          "cwd": "libs/prisma-schema/prisma"
        },
        "defaultConfiguration": "e2e",
        "dependsOn": [
          "prisma-migrate:e2e"
        ]
      }
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {}
}
