{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../util/api-types/tsconfig.lib.json"
    },
    {
      "path": "../../../api/data-access/user/tsconfig.lib.json"
    },
    {
      "path": "../../../prisma-schema/tsconfig.lib.json"
    },
    {
      "path": "../../util/validation/tsconfig.lib.json"
    },
    {
      "path": "../../util/shared-constants/tsconfig.lib.json"
    }
  ]
}
