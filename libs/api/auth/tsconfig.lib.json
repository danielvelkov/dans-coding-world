{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../shared/util/exceptions/tsconfig.lib.json"
    },
    {
      "path": "../../shared/util/shared-constants/tsconfig.lib.json"
    },
    {
      "path": "../data-access/user/tsconfig.lib.json"
    },
    {
      "path": "../../prisma-schema/tsconfig.lib.json"
    },
    {
      "path": "../../shared/auth/dtos/tsconfig.lib.json"
    }
  ],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
