{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../../shared/post/dtos/tsconfig.lib.json"
    },
    {
      "path": "../../../prisma-schema/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/data-access/api/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/util/api-types/tsconfig.lib.json"
    },
    {
      "path": "../../../public-blog/data-access/blog-api/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/auth/dtos/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
